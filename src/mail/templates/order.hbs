<div>
  <div>
    <h5>Информация о заказе:</h5>
    <table>
      <tbody>
        <tr><td>Дата:</td><td>{{orderDate}}</td></tr>
        <tr><td>Сумма:</td><td>{{orderSum}}</td></tr>
        <tr><td>Доставка:</td><td>{{deliveryType}}</td></tr>
        <tr><td>Адрес:</td><td>{{address}}</td></tr>
        <tr><td>Тип оплаты:</td><td>{{paymentType}}</td></tr>
        <tr><td>Статус заказа:</td><td>{{orderStatus}}</td></tr>
      </tbody>
    </table>
    <h5>Информация о покупателе:</h5>
    <table>
      <tbody>
        <tr><td>Имя:</td><td>{{buyerName}}</td></tr>
        <tr><td>Телефон:</td><td>{{buyerPhone}}</td></tr>
        <tr><td>Комментарий:</td><td>{{comment}}</td></tr>
      </tbody>
    </table>
  </div>
  <div>
    <h5>Товары:</h5>
    {{{positions}}}
  </div>
</div>